% ---------------------------------------------------------------------------
% TONER-1 launch handout. Level 1 PostScript, standard 35 fonts, grayscale.
% Everything below is drawn with vector graphics; no images.
% ---------------------------------------------------------------------------
/TN 400 dict def
TN begin

% ---- encoding: StandardEncoding plus a few Latin glyphs in unused slots ----
/TNEnc StandardEncoding 256 array copy def
TNEnc 128 /degree put       % \200
TNEnc 129 /multiply put     % \201
TNEnc 130 /plusminus put    % \202
TNEnc 131 /minus put        % \203
TNEnc 160 /space put        % \240  non-breaking space (not a wrap point)
/refont { % /NewName /BaseFont refont -
  findfont dup length dict begin
    { 1 index /FID ne { def } { pop pop } ifelse } forall
    /Encoding TNEnc def
    currentdict
  end definefont pop
} bind def
/TN-H  /Helvetica refont
/TN-HB /Helvetica-Bold refont
/TN-HO /Helvetica-Oblique refont
/TN-T  /Times-Roman refont
/TN-TI /Times-Italic refont
/TN-TB /Times-Bold refont
/TN-C  /Courier refont
/fH   { /TN-H  findfont exch scalefont setfont } bind def
/fHB  { /TN-HB findfont exch scalefont setfont } bind def
/fHO  { /TN-HO findfont exch scalefont setfont } bind def
/fT   { /TN-T  findfont exch scalefont setfont } bind def
/fTI  { /TN-TI findfont exch scalefont setfont } bind def
/fTB  { /TN-TB findfont exch scalefont setfont } bind def
/fC   { /TN-C  findfont exch scalefont setfont } bind def

% ---- text helpers ----
/rsh { dup stringwidth pop neg 0 rmoveto show } bind def          % right-aligned
/csh { dup stringwidth pop 2 div neg 0 rmoveto show } bind def    % centered
/tsh { exch 0 exch ashow } bind def                               % (s) track tsh
/tw  { exch dup stringwidth pop exch length 3 -1 roll mul add } bind def
/trsh { 2 copy tw 1 index sub neg 0 rmoveto tsh } bind def        % right-aligned, tracked
/nstr 16 string def

% ---- vector helpers ----
/rf { % x y w h gray -> filled rectangle
  gsave setgray /rh exch def /rw exch def /ry exch def /rx exch def
  newpath rx ry moveto rw 0 rlineto 0 rh rlineto rw neg 0 rlineto closepath fill
  grestore } bind def
/rs { % x y w h linewidth gray -> stroked rectangle
  gsave setgray setlinewidth /rh exch def /rw exch def /ry exch def /rx exch def
  newpath rx ry moveto rw 0 rlineto 0 rh rlineto rw neg 0 rlineto closepath stroke
  grestore } bind def
/hl { % x1 x2 y linewidth gray -> horizontal rule
  gsave setgray setlinewidth 0 setlinecap /ly exch def /lx2 exch def /lx1 exch def
  newpath lx1 ly moveto lx2 ly lineto stroke grestore } bind def
/vl { % x y1 y2 linewidth gray -> vertical rule
  gsave setgray setlinewidth 0 setlinecap /ly2 exch def /ly1 exch def /lx exch def
  newpath lx ly1 moveto lx ly2 lineto stroke grestore } bind def
/hatchbox { % x y w h -> diagonal hatch, clipped, with a thin outline
  /hh exch def /hw exch def /hy exch def /hx exch def
  gsave
    newpath hx hy moveto hw 0 rlineto 0 hh rlineto hw neg 0 rlineto closepath clip
    newpath 0.4 setlinewidth 0.6 setgray
    hx hh sub 3.2 hx hw add { hy moveto hh hh rlineto } for stroke
  grestore
  hx hy hw hh 0.5 0.45 rs } bind def
/arrowv { % x baseline up? -> small vector arrow (up or down), 5.6 pt tall
  /aup exch def /ay exch def /ax exch def
  gsave 0 setgray 0.7 setlinewidth 0 setlinecap newpath
  aup { ax ay moveto ax ay 3.6 add lineto stroke
        newpath ax 1.7 sub ay 3.2 add moveto ax 1.7 add ay 3.2 add lineto ax ay 5.8 add lineto closepath fill }
      { ax ay 5.8 add moveto ax ay 2.2 add lineto stroke
        newpath ax 1.7 sub ay 2.6 add moveto ax 1.7 add ay 2.6 add lineto ax ay lineto closepath fill } ifelse
  grestore } bind def
/dot  { % x y r -> filled circle
  newpath 0 360 arc closepath fill } bind def
/odot { % x y r -> hollow circle with white fill
  /oR exch def /oy exch def /ox exch def
  gsave newpath ox oy oR 0 360 arc closepath 1 setgray fill grestore
  gsave newpath ox oy oR 0 360 arc closepath 0.6 setlinewidth 0 setgray stroke grestore } bind def

% ---- word-wrap flow engine ----
% left right baseline leading fl-begin ; then set a font and call (text) fseg
% repeatedly (fonts may change between segments). fY holds the last baseline.
/fl-begin { /fLd exch def /fY exch def /fR exch def /fL exch def
  /fX fL def /fNoSp false def } bind def
/fnl { /fY fY fLd sub def /fX fL def } bind def
/fword { /fw exch def /fww fw stringwidth pop def
  fX fL gt {
    fNoSp { 0 } { ( ) stringwidth pop } ifelse /fsp exch def
    fX fsp add fww add fR gt { fnl } { /fX fX fsp add def } ifelse
  } if
  /fNoSp false def
  fX fY moveto fw show
  /fX fX fww add def } bind def
/fseg { % (text) fseg -- split on spaces and flow each word
  { dup length 0 eq { pop exit } if
    ( ) search
    { exch pop exch /frest exch def dup length 0 gt { fword } { pop } ifelse frest }
    { fword exit } ifelse
  } loop } bind def
/fjoin { /fNoSp true def } bind def    % next word attaches with no space

% ---- page furniture ----
/header { % (SECTION) header
  /hsec exch def
  0 setgray 7.2 fHB 54 731 moveto (TONER-1) 1.5 tsh
  0.45 setgray 7.2 fH (   /   ) show
  0 setgray hsec 1.5 tsh
  0.35 setgray 7.2 fH 558 731 moveto (RELEASE 1.0   /   NOVEMBER 2026) 1.5 trsh
  54 558 722 1.8 0 hl } bind def
/footer { % (page n of 2) footer
  /fpg exch def
  54 558 72 0.5 0 hl
  0.3 setgray 6.6 fH 54 61 moveto
  (TONER-1 is a working print job and a parody of frontier-model launches. This handout is a PostScript program, too.) show
  54 52.4 moveto (Not affiliated with or endorsed by Adobe, HP, Artifex, Google, or any AI lab.) show
  6.6 fHB 0 setgray 558 61 moveto fpg rsh } bind def
/sechead { % x1 x2 y (TITLE) sechead -- tracked caps with a rule 5 pt below
  /shT exch def /shy exch def /shx2 exch def /shx1 exch def
  0 setgray 7.2 fHB shx1 shy moveto shT 1.2 tsh
  shx1 shx2 shy 5 sub 0.8 0 hl } bind def

% ---- page 1: specification table (left, x 54..384) ----
/spec { % (label) {value} spec   -- uses and updates rowY
  /svp exch def /slb exch def
  0 setgray 7.4 fHB 54 rowY 10.6 sub moveto slb 0.15 tsh
  150 384 rowY 10.6 sub 10.3 fl-begin 0 setgray 8.2 fH svp
  /rowY fY 5.2 sub def
  54 384 rowY 0.35 0.6 hl } bind def

% ---- page 1: right column (x 402..558) ----
/cL 402 def /cR 558 def /cLd 11.3 def
/chead { % (TITLE) chead -- at curY
  cL cR curY 4 -1 roll sechead /curY curY 5 sub 11.8 sub def } bind def
/cpara { % {proc} cpara
  /cpp exch def cL cR curY cLd fl-begin 0 setgray 9 fT cpp /curY fY cLd sub def } bind def
/citem { % {proc} citem -- square bullet with hanging indent
  /cpp exch def
  cL curY 2.6 add 2.6 2.6 0 rf
  cL 8.5 add cR curY cLd fl-begin 0 setgray 9 fT cpp /curY fY cLd sub 2.2 sub def } bind def

% ---- page 1: product lineup box ----
/lbox { % x (Name) (TAG) tagfilled? (specline) {desc} lbox
  /lbd exch def /lbs exch def /lbf exch def /lbt exch def /lbn exch def /lbx exch def
  /lbw 156 def /lbtop 171 def /lbh 80 def
  lbx lbtop lbh sub lbw lbh 0.6 0 rs
  0 setgray 10.6 fHB lbx 9 add lbtop 16 sub moveto lbn show
  % tag
  6 fHB /lbtw lbt 0.8 tw 0.8 sub def
  lbf { lbx lbw add 9 sub lbtw sub 5 sub lbtop 18.6 sub lbtw 10 add 10 0 rf 1 setgray }
      { lbx lbw add 9 sub lbtw sub 5 sub lbtop 18.6 sub lbtw 10 add 10 0.6 0 rs 0 setgray } ifelse
  lbx lbw add 9 sub lbtw sub lbtop 15.3 sub moveto lbt 0.8 tsh
  lbx 9 add lbx lbw add 9 sub lbtop 23.5 sub 0.35 0.6 hl
  0.25 setgray 6.8 fHB lbx 9 add lbtop 33 sub moveto lbs 0.3 tsh
  lbx 9 add lbx lbw add 9 sub lbtop 44.5 sub 9.8 fl-begin 0 setgray 8.4 fT lbd } bind def

% ---- page 2: benchmark panel (small multiples) ----
/px0 238 def /px1 522 def /pW px1 px0 sub def
/xv { pMax div pW mul px0 add } bind def
/tlab { % value x y -> centered tick label with pPre/pSuf
  /ty exch def /tx exch def cvi nstr cvs /tn exch def
  /tws pPre stringwidth pop tn stringwidth pop add pSuf stringwidth pop add def
  tx tws 2 div sub ty moveto pPre show tn show pSuf show } bind def
/panel { % expects pTop pName pDesc pDir pMax pStep pVal pValS pPre pSuf pExtra
  % left block: name, description, direction
  0 setgray 9.6 fHB 54 pTop 11 sub moveto pName show
  54 212 pTop 21 sub 8.4 fl-begin 0.3 setgray 7 fH pDesc
  /pdy fY 10.2 sub def
  0 setgray 6.2 fHB 54 pdy moveto pDir 0 eq { (HIGHER IS BETTER) } { (LOWER IS BETTER) } ifelse 0.7 tsh
  currentpoint exch 4.6 add exch pDir 0 eq arrowv
  % gridlines, ticks, tick labels
  /pAx pTop 41 sub def
  6.4 fH
  0 pStep pMax {
    /tv exch def
    tv 0 gt { tv xv pAx pTop 5 sub 0.3 0.78 vl } if
    tv xv pAx pAx 2.6 sub 0.5 0 vl
    0.3 setgray tv tv xv pAx 9.4 sub tlab
  } for
  % TONER-1 bar
  px0 pTop 21 sub pVal xv px0 sub 11 0.12 rf
  % frontier models: no result
  px0 pTop 36 sub pW 11 hatchbox
  6.6 fHO /nas (N/A: cannot execute inside a print job) def
  /nw nas stringwidth pop def
  px0 pW 2 div add nw 2 div sub 5 sub pTop 34.6 sub nw 10 add 8.2 1 rf
  0.2 setgray px0 pW 2 div add nw 2 div sub pTop 32.9 sub moveto nas show
  % axis
  px0 px1 pAx 0.6 0 hl
  px0 pTop 5 sub pAx 0.6 0 vl
  pExtra
  % value label on the TONER-1 bar
  8 fHB /vw pValS stringwidth pop def /vx pVal xv def
  vx 5 add vw add 558 gt
    { 1 setgray vx 5 sub vw sub pTop 18.4 sub moveto pValS show }
    { 0 setgray vx 5 add pTop 18.4 sub moveto pValS show } ifelse
  % separator
  54 558 pTop 57 sub 0.35 0.7 hl } bind def

% ---- page 2: scaling-law plot ----
/gx0 86 def /gx1 320 def /gy0 162 def /gy1 260 def
/pgx { log 4 div gx1 gx0 sub mul gx0 add } bind def     % pages -> x (1..10^4)
/pgy { 20 sub 60 div gy1 gy0 sub mul gy0 add } bind def % quality -> y (20..80)

% ---- page 2: evaluation setup rows (x 350..558) ----
/erow { % (label) {value} erow -- uses and updates eY
  /evp exch def /elb exch def
  0 setgray 6.8 fHB 348 eY 9.6 sub moveto elb show
  414 558 eY 9.6 sub 8.8 fl-begin 0 setgray 7.3 fH evp
  /eY fY 4.6 sub def
  348 558 eY 0.35 0.6 hl } bind def
end
