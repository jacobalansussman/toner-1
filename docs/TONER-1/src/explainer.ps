% ---------- diagram pieces ----------
/node { % x y w h [ /Font size gray (text) ... ]
  /nl exch def /nh exch def /nw exch def /ny exch def /nx exch def
  gsave 1 setgray nx ny nw nh rectp fill grestore
  0 setgray 0.8 setlinewidth nx ny nw nh rectp stroke
  /nth 0 def 0 4 nl length 1 sub { /k exch def /nth nth nl k 1 add get 1.2 mul add def } for
  /nyy ny nh 2 div add nth 2 div add def
  0 4 nl length 1 sub { /k exch def
    /nyy nyy nl k 1 add get 1.2 mul sub def
    nl k 2 add get setgray nl k get nl k 1 add get F
    nx nw 2 div add nyy nl k 1 add get 0.22 mul add moveto nl k 3 add get cshow } for
  0 setgray } bind def
/laptop { % x y  (bottom-left of base; 48 x 30)
  /ly exch def /lx exch def
  0 setgray 0.9 setlinewidth
  lx 5 add ly 4.5 add 38 25 2 rrectp gsave 1 setgray fill grestore stroke
  lx 8 add ly 7.5 add 32 19 rectp 0.18 setgray fill
  1 setgray /CB 7 F lx 11 add ly 15 add moveto ($) show
  lx 17 add ly 15 add 4 5 rectp fill
  0 setgray newpath lx ly moveto lx 48 add ly lineto lx 45 add ly 4 add lineto lx 3 add ly 4 add lineto closepath
  gsave 0.7 setgray fill grestore stroke } bind def
/paper { % x y w h
  /ph exch def /pw exch def /py exch def /px exch def /pf 8 def
  0 setgray 0.8 setlinewidth
  newpath px py moveto px pw add py lineto px pw add py ph add pf sub lineto
  px pw add pf sub py ph add lineto px py ph add lineto closepath
  gsave 1 setgray fill grestore stroke
  newpath px pw add pf sub py ph add moveto px pw add pf sub py ph add pf sub lineto
  px pw add py ph add pf sub lineto closepath gsave 0.8 setgray fill grestore stroke
  px 5 add px pw add 11 sub py ph add 9 sub 1.4 hline
  0.65 setgray
  [ 14 0.92 18 0.84 22 0.9 26 0.78 30 0.5 ] /pl exch def
  0 2 pl length 1 sub { /k exch def
    px 5 add px 5 add pw 10 sub pl k 1 add get mul add py ph add pl k get sub 0.7 hline } for
  0 setgray } bind def
end
