TX begin

% ---------- fonts: standard 35 only, re-encoded to add a few Latin glyphs ----------
/MyEnc StandardEncoding 256 array copy def
MyEnc 215 /multiply put
MyEnc 176 /degree put
/reenc { % /New /Old reenc
  findfont dup length dict begin
    { 1 index /FID ne { def } { pop pop } ifelse } forall
    /Encoding MyEnc def currentdict
  end definefont pop } bind def
/F { exch findfont exch scalefont setfont } bind def          % /Name size F
/sw { stringwidth pop } bind def
/rshow { dup sw neg 0 rmoveto show } bind def
/cshow { dup sw 2 div neg 0 rmoveto show } bind def
/tshow { 0 3 -1 roll ashow } bind def                         % (s) track tshow
/tsw { exch dup length 3 -1 roll mul exch sw add } bind def   % (s) track -> w
/rtshow { 2 copy tsw neg 0 rmoveto tshow } bind def

/LM 54 def /RM 558 def /CW 504 def

% ---------- geometry ----------
/rectp { newpath 4 2 roll moveto 1 index 0 rlineto 0 exch rlineto neg 0 rlineto closepath } bind def
/rrectp { /rr exch def /rh exch def /rw exch def /ry exch def /rx exch def
  newpath rx rr add ry moveto
  rx rw add ry rx rw add ry rh add rr arct
  rx rw add ry rh add rx ry rh add rr arct
  rx ry rh add rx ry rr arct
  rx ry rx rw add ry rr arct closepath } bind def
/hline { % x1 x2 y w
  setlinewidth /hy exch def newpath hy moveto hy lineto stroke } bind def
/ahl 4.6 def /ahw 2.2 def
/arrowhead { gsave 3 1 roll translate rotate newpath 0 0 moveto
  ahl neg ahw lineto ahl neg ahw neg lineto closepath fill grestore } bind def
/parrow { % [x0 y0 x1 y1 ... ] polyline with arrowhead at the end
  /pa exch def /pn pa length def
  /ax1 pa pn 4 sub get def /ay1 pa pn 3 sub get def
  /ax2 pa pn 2 sub get def /ay2 pa pn 1 sub get def
  /aa ay2 ay1 sub ax2 ax1 sub atan def
  newpath pa 0 get pa 1 get moveto
  2 2 pn 4 sub { /k exch def pa k get pa k 1 add get lineto } for
  ax2 aa cos ahl 0.7 mul mul sub ay2 aa sin ahl 0.7 mul mul sub lineto stroke
  ax2 ay2 aa arrowhead } bind def
/patch { % x y w h : white knockout behind a label
  gsave 1 setgray rectp fill grestore } bind def

% ---------- word wrap ----------
% Words prefixed with ` are set in the code font, ^ in the bold font.
% ~ is a non-breaking space. A lone | starts a new paragraph.
/wsz 9.4 def /wld 12.4 def /wfR /TR def /wfB /TB def /wfC /CR def
/wcs 0.94 def /wbs 1 def /wdraw true def /wgray 0 def /wpar 1.5 def
/wsetR { wfR findfont wsz scalefont setfont } bind def
/wpunct { dup 46 eq 1 index 44 eq or 1 index 59 eq or exch 58 eq or } bind def
/wtilde { dup length string copy dup length 1 sub 0 exch 1 exch
  { 2 copy get 126 eq { 1 index exch 32 put } { pop } ifelse } for } bind def
/wword1 {
  /wtail () def
  dup 0 get 96 eq { dup length 1 sub 1 exch getinterval /wfn wfC def /wfs wsz wcs mul def /wspec true def }
  { dup 0 get 94 eq { dup length 1 sub 1 exch getinterval /wfn wfB def /wfs wsz wbs mul def /wspec false def }
    { /wfn wfR def /wfs wsz def /wspec false def } ifelse } ifelse
  wspec { dup length 1 gt { dup dup length 1 sub get wpunct {
      dup dup length 1 sub 1 getinterval /wtail exch def
      dup length 1 sub 0 exch getinterval } if } if } if
  wtilde /wmain exch def } bind def
/wplace {
  wword1
  wfn findfont wfs scalefont setfont wmain sw
  wsetR wtail sw add /wwd exch def
  wbol not { wcx wspw add wwd add wx ww add gt
      { /wy wy wld sub def /wcx wx def } { /wcx wcx wspw add def } ifelse } if
  wdraw { wcx wy moveto wfn findfont wfs scalefont setfont wmain show wsetR wtail show } if
  /wcx wcx wwd add def /wbol false def } bind def
/wrap { % (text) x y width  -> draws; /wy = last baseline
  /ww exch def /wy exch def /wx exch def
  wgray setgray wsetR /wspw ( ) sw def
  /wcx wx def /wbol true def
  { dup length 0 eq { pop exit } if
    ( ) search { /wtok exch def pop /wrest exch def } { /wtok exch def () /wrest exch def } ifelse
    wtok length 0 gt { wtok (|) eq { /wy wy wld wpar mul sub def /wcx wx def /wbol true def }
                                   { wtok wplace } ifelse } if
    wrest } loop
  0 setgray } bind def
/wmeasure { /wdraw false def wrap /wdraw true def wy } bind def   % -> last baseline

% ---------- code blocks ----------
/csz 6.8 def /cld 8.3 def /cpad 6 def /cgut 20 def /cextra 0 def /cxproc {} def
/cfont { cbold { /CB } { /CR } ifelse csz F } bind def
/cseg { { (...) search { show pop gsave 0.6 setgray (...) show currentpoint grestore moveto }
          { show exit } ifelse } loop } bind def
/cline { /cbold false def
  dup length 0 gt { dup 0 get 37 eq } { false } ifelse { 0.45 setgray } { 0 setgray } ifelse
  { (@@) search { cfont cseg pop /cbold cbold not def } { cfont cseg exit } ifelse } loop
  0 setgray } bind def
/cbh { length 2 idiv 1 sub cld mul cpad 2 mul add csz 0.95 mul add cextra add } bind def
/codeblock { % [ (n) (line) ... ] x ytop w
  /cw exch def /cyt exch def /cx exch def /cl exch def
  /chh cl cbh def
  gsave 0.925 setgray cx cyt chh sub cw chh rectp fill grestore
  gsave 0 setgray cx cyt chh sub 1.6 chh rectp fill grestore
  /cyy cyt cpad sub csz 0.72 mul sub def
  0 2 cl length 1 sub { /ci exch def
    0.55 setgray /CR 5.6 F cx cgut add 4 sub cyy moveto cl ci get rshow
    0 setgray cx cgut add cyy moveto cl ci 1 add get cline
    /cyy cyy cld sub def } for
  cxproc
  /cextra 0 def /cxproc {} def } bind def

