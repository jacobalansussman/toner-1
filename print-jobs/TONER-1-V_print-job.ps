% ---------------- TONER-1-V doodle engine (16x16 pixel art, same forward pass as the story) ----------------
% Needs /DOODLE from doodle_weights.ps. Adds four names to the current dictionary (userdict):
%   /DENG    dictionary: engine2.ps's forward pass, the doodle's own activation buffers and KV cache, the
%            masked sampler, and the bitmap decoder. Every scratch name lives in DENG, never in userdict.
%   /DTEMP   doodle sampling temperature (default 0.9; gs -dDTEMP=... overrides).
%   /TVgen   cls seed TVgen -        sample one doodle of class index cls (0..17) from rand seeded with seed
%   /TVdraw  x y size r g b TVdraw - draw the last doodle with imagemask in an RGB color, size x size points
% and TVcolor (cls -> r g b), TVms (-> usertime ms of the last TVgen), TVprint (ASCII art to stdout).
% While TONER-1-V runs, the dictionary stack is  ... userdict DOODLE DENG , so engine2's procedures
% (copied verbatim below) find the doodle's weights, sizes and buffers first, and the story model's
% names in userdict are never read or written. Level 2 operators or lower only.
/=only where { pop } { /=only { dup type /stringtype ne { 64 string cvs } if print } bind def } ifelse
/DTEMP where { pop } { /DTEMP 0.9 def } ifelse
/DENG 200 dict def
DOODLE begin DENG begin

% ======== begin: verbatim copy of engine2.ps, from "/E 2.718281828 def" to the end of /forward ========
/E 2.718281828 def

/zeros { /zn exch def zn array 0 1 zn 1 sub { 1 index exch 0.0 put } for } bind def

% o x w rmsnorm
/rmsnorm { /rw exch def /rx exch def /ro exch def
  0 rx { dup mul add } forall rx length div 1e-5 add sqrt 1 exch div /rs exch def
  0 1 rx length 1 sub { /ri exch def ro ri rx ri get rs mul rw ri get mul put } for
} bind def

% o x M mv  ;  M = [scales rows], rows are int8 strings offset by 128
/mv { /mM exch def /mx exch def /mo exch def
  /mS mM 0 get def /mQ mM 1 get def /mn mx length 1 sub def
  /msx 0 mx { add } forall 128 mul def
  0 1 mQ length 1 sub { /mi exch def /mrow mQ mi get def
    0 0 1 mn { dup mrow exch get exch mx exch get mul add } for
    msx sub mS mi get mul mo mi 3 -1 roll put } for
} bind def

% vec n rope   (uses pos; PostScript trig takes DEGREES)
/rope { /rn exch def /rv exch def
  0 2 rn 1 sub { /ri exch def
    /hd ri HS mod def
    pos 10000 hd HS div exp div 57.29577951 mul /ang exch def
    /fcr ang cos def /fci ang sin def
    /v0 rv ri get def /v1 rv ri 1 add get def
    rv ri v0 fcr mul v1 fci mul sub put
    rv ri 1 add v0 fci mul v1 fcr mul add put } for
} bind def

/x D zeros def /xb D zeros def /xb2 D zeros def /q D zeros def
/hb HID zeros def /hb2 HID zeros def /logits V zeros def /att SEQ zeros def
/KC [ NL { SEQ array } repeat ] def /VC [ NL { SEQ array } repeat ] def
/isq 1 HS sqrt div def

/attention {
  /kl KC l get def /vl VC l get def
  0 1 NH 1 sub { /h exch def /qo h HS mul def /ko h KVMUL idiv HS mul def
    /amx -1e30 def
    0 1 pos { /t exch def /kt kl t get def
      0 0 1 HS 1 sub { /j exch def q qo j add get kt ko j add get mul add } for
      isq mul dup att t 3 -1 roll put dup amx gt { /amx exch def } { pop } ifelse } for
    /ssum 0 def
    0 1 pos { /t exch def att t get amx sub dup -80 lt { pop -80 } if E exch exp
      dup ssum add /ssum exch def att t 3 -1 roll put } for
    0 1 HS 1 sub { /j exch def
      0 0 1 pos { /t exch def att t get vl t get ko j add get mul add } for
      ssum div xb qo j add 3 -1 roll put } for
  } for
} bind def

% token pos forward -> logits filled
/forward { /pos exch def /tok exch def
  /es EMB 0 get tok get def /er EMB 1 get tok get def
  0 1 D 1 sub { /j exch def x j er j get 128 sub es mul put } for
  0 1 NL 1 sub { /l exch def
    xb x RMSATT l get rmsnorm
    q xb WQ l get mv
    /k KVD zeros def /v KVD zeros def
    k xb WK l get mv  v xb WV l get mv
    q D rope  k KVD rope
    KC l get pos k put  VC l get pos v put
    attention
    xb2 xb WO l get mv
    0 1 D 1 sub { /j exch def x j x j get xb2 j get add put } for
    xb x RMSFFN l get rmsnorm
    hb xb W1 l get mv  hb2 xb W3 l get mv
    0 1 HID 1 sub { /j exch def /hv hb j get def
      hb j hv 1 E hv neg dup -80 lt { pop -80 } if exp add div hb2 j get mul put } for
    xb hb W2 l get mv
    0 1 D 1 sub { /j exch def x j x j get xb j get add put } for
  } for
  x x RMSF rmsnorm
  logits x EMB mv
} bind def
% ======== end of the verbatim copy. The buffers above were created with the doodle's D, HID, V, SEQ, NL. ========

% -> token. engine2's /sample restricted to the 16 patch tokens PATCH0 .. PATCH0+15 (the other 20
% logits are ignored, i.e. masked to probability 0). Same softmax-with-temperature, same single rand draw.
/dsample {
  /dlo PATCH0 def /dhi PATCH0 NPATCHV add 1 sub def
  /dbv -1e30 def /dbest dlo def
  dlo 1 dhi { /dj exch def logits dj get dup dbv gt { /dbv exch def /dbest dj def } { pop } ifelse } for
  DTEMP 0 le { dbest } {
    /dsum 0 def
    dlo 1 dhi { /dj exch def logits dj get dbv sub DTEMP div dup -80 lt { pop -80 } if E exch exp
      dup dsum add /dsum exch def logits dj 3 -1 roll put } for
    /dr rand 2147483647 div dsum mul def /dcum 0 def /dpick dbest def
    dlo 1 dhi { /dj exch def /dcum dcum logits dj get add def dcum dr gt { /dpick dj def exit } if } for
    dpick
  } ifelse
} bind def

/PV NPATCH array def          % the 64 sampled patch values 0..15, raster order over the 8x8 grid
/BITS IMG IMG mul 8 idiv string def   % 16x16 one-bit bitmap, 2 bytes per row, top row first, 1 = ink
/UPS 2048 string def          % the same bitmap repeated 8x8 (128x128 bits), so every doodle pixel is a block
/dms 0 def

% cls seed dgen -   BOS, CLASS0+cls, then 64 sampled patches; 65 forward passes
/dgen { /dseed exch def /dcls exch def
  dseed srand 4 { rand pop } repeat       % as engine2.ps: the first draws after a small seed are tiny
  usertime /dt0 exch def
  BOS 0 forward
  /dtok CLASS0 dcls add def
  1 1 NPATCH { /dpos exch def
    dtok dpos forward
    /dtok dsample def
    PV dpos 1 sub dtok PATCH0 sub put
  } for
  usertime dt0 sub /dms exch def
  dbits
} bind def

% patches -> BITS.  v = 8*TL + 4*TR + 2*BL + 1*BR; patch i covers rows 2(i/8), 2(i/8)+1 and
% columns 2(i mod 8), 2(i mod 8)+1; bits are MSB first within each byte.
/dbits {
  0 1 BITS length 1 sub { BITS exch 0 put } for
  0 1 NPATCH 1 sub { /dq exch def /dv PV dq get def
    /dgc dq GRID mod def
    /dsh 6 dgc 4 mod 2 mul sub def
    /dbi dq GRID idiv 4 mul dgc 4 idiv add def
    BITS dbi BITS dbi get dv -2 bitshift dsh bitshift or put
    BITS dbi 2 add BITS dbi 2 add get dv 3 and dsh bitshift or put
  } for
} bind def

% row col dpix -> 0|1
/dpix { exch 2 mul 1 index 8 idiv add BITS exch get exch 8 mod 7 exch sub neg bitshift 1 and } bind def

% BITS -> UPS: nearest-neighbour 8x (one byte of 8 equal bits per doodle pixel, each row 8 times).
% A one-bit block image prints identically to the 16x16 mask, and PDF viewers that smooth
% upscaled images cannot blur its pixel edges.
/dups {
  0 1 15 { /dry exch def
    0 1 15 { /dcx exch def
      dry dcx dpix 1 eq { 255 } { 0 } ifelse /db8 exch def
      0 1 7 { dry 8 mul add 16 mul dcx add UPS exch db8 put } for
    } for
  } for
} bind def

% x y size r g b ddraw -   imagemask in the current color; pixel (0,0) is the top-left corner
/ddraw { /dcb exch def /dcg exch def /dcr exch def /dsz exch def /ddy exch def /ddx exch def
  dups
  gsave ddx ddy translate dsz dsz scale dcr dcg dcb setrgbcolor
    128 128 true [128 0 0 -128 0 128] { UPS } imagemask
  grestore
} bind def

% ASCII art of the last doodle on stdout ('#' = ink), plus its 64 patch values
/dprint {
  0 1 15 { /dry exch def ( ) print 0 1 15 { dry exch dpix 1 eq { (#) } { (.) } ifelse print } for (\n) print } for
} bind def
/dtokprint { 0 1 NPATCH 1 sub { PV exch get =only ( ) print } for } bind def

% class colors (RGB), CLASSES order
/DCOL [
  [0.86 0.45 0.10]  % cat         ginger
  [0.50 0.32 0.18]  % dog         brown
  [0.80 0.12 0.20]  % bird        cardinal red
  [0.05 0.40 0.80]  % fish        blue
  [0.00 0.52 0.52]  % duck        mallard teal
  [0.55 0.42 0.60]  % rabbit      lilac grey
  [0.38 0.62 0.08]  % frog        lime green
  [0.72 0.46 0.16]  % teddy-bear  honey
  [0.96 0.58 0.00]  % sun         yellow-orange
  [0.06 0.46 0.20]  % tree        forest green
  [0.78 0.14 0.58]  % flower      magenta
  [0.62 0.24 0.14]  % house       brick
  [0.15 0.25 0.70]  % car         cobalt
  [0.84 0.08 0.12]  % apple       red
  [0.92 0.40 0.60]  % cake        frosting pink
  [0.12 0.12 0.12]  % soccer ball black
  [0.82 0.62 0.00]  % light bulb  amber
  [0.32 0.38 0.46]  % calculator  slate
] def
end end

/TVgen { DOODLE begin DENG begin dgen end end } bind def
/TVdraw { DOODLE begin DENG begin ddraw end end } bind def
/TVcolor { DENG /DCOL get exch get aload pop } bind def
/TVms { DENG /dms get } bind def
/TVprint { DOODLE begin DENG begin dprint end end } bind def
/TVtokprint { DOODLE begin DENG begin dtokprint end end } bind def
% ---------------- end of TONER-1-V doodle engine ----------------
% ---------------- TONER-1-V: route the story to a class, draw it, typeset the illustrated page ----------------
% Runs after engine2.ps has generated the story into TEXT (with PAGE false, so engine2 prints no page of
% its own) and after doodle_weights.ps + doodle_engine.ps. The page layout is engine2.ps's, with the
% token stream and the "how this page was made" band replaced by the doodle, its caption and its tokens.
/DSEED where { pop } { /DSEED SEED def } ifelse

% ---- keyword router: the first word of the story that names something TONER-1-V can draw ----
% Words are maximal runs of ASCII letters, compared case-insensitively; a trailing "s" (plural) is allowed.
/RT 48 dict def RT begin
  /cat 0 def /kitty 0 def /kitties 0 def
  /dog 1 def /puppy 1 def /puppies 1 def
  /bird 2 def /fish 3 def /duck 4 def
  /bunny 5 def /bunnies 5 def /rabbit 5 def /frog 6 def
  /bear 7 def /teddy 7 def /teddies 7 def
  /sun 8 def /tree 9 def /flower 10 def /house 11 def /home 11 def
  /car 12 def /apple 13 def /cake 14 def /ball 15 def /lamp 16 def /light 16 def
end
/rtletter { dup 65 ge 1 index 90 le and exch dup 97 ge exch 122 le and or } bind def   % byte -> bool
/rtlower { dup 65 ge 1 index 90 le and { 32 add } if } bind def
% -> bool; on success sets rtcls (class index), rtword (the word as written, lower case), rtwn (word number, 1-based)
/route {
  /rtfound false def /rti 0 def /rtwn 0 def
  { rti tlen ge { exit } if
    TEXT rti get rtletter {
      /rts rti def /rtwn rtwn 1 add def
      { rti tlen ge { exit } if TEXT rti get rtletter not { exit } if /rti rti 1 add def } loop
      /rtl rti rts sub def
      rtl 40 le {
        /rtw rtl string def
        0 1 rtl 1 sub { /rk exch def rtw rk TEXT rts rk add get rtlower put } for
        RT rtw known { /rtcls RT rtw get def /rtfound true def } {
          rtl 2 ge { rtw rtl 1 sub get 115 eq {
            rtw 0 rtl 1 sub getinterval dup RT exch known { RT exch get /rtcls exch def /rtfound true def } { pop } ifelse
          } if } if
        } ifelse
        rtfound { /rtword rtw def exit } if
      } if
    } { /rti rti 1 add def } ifelse
  } loop
  rtfound } bind def
% n wcount -> number of space- or newline-separated words that start before byte n (as typeset)
/wcount { /wn exch def /wc 0 def
  0 1 wn 1 sub { /ci exch def TEXT ci get dup 32 ne exch 10 ne and
    { ci 0 eq { true } { TEXT ci 1 sub get dup 32 eq exch 10 eq or } ifelse { /wc wc 1 add def } if } if } for wc } bind def
/NWORDS tlen wcount def

route { /DCLS rtcls def /ROUTED true def /rtwn rts 1 add wcount def }
      { /DCLS DSEED abs DOODLE /NCLASS get mod def /ROUTED false def } ifelse
/DNAME DOODLE /CLASSES get DCLS get def

(\nTONER-1-V | ) print DOODLE /NPARAMS get =only ( params | router: ) print
ROUTED { (") print rtword print (", word ) print rtwn =only ( -> ) print }
       { (no drawable noun; class = DSEED mod 18 = ) print DCLS =only ( -> ) print } ifelse
DNAME print ( | seed ) print DSEED =only ( | T ) print DTEMP =only (\n) print flush
DCLS DSEED TVgen
TVprint
/dms TVms def /dtps dms 0 gt { 64 dms 1000 div div } { 0 } ifelse def
(64 patch tokens: ) print TVtokprint (\n) print
(---\n64 patch tokens \(65 forward passes\) in ) print dms 1000 div =only ( s = ) print dtps =only ( tok/s\n) print flush

% ---------------- typesetting: engine2.ps's page, with the doodle in place of the token stream ----------------
/setpagedevice where { pop mark { 1 dict dup /PageSize [612 792] put setpagedevice } stopped cleartomark } if

% helpers, as in engine2.ps
/cat { /c2 exch def /c1 exch def c1 length c2 length add string
  dup 0 c1 putinterval dup c1 length c2 putinterval } bind def
/fmt { /fd exch def /fv exch def /fm 1 def fd { /fm fm 10 mul def } repeat   % num decimals -> string
  /fi fv fm mul round cvi def fi fm idiv 12 string cvs
  fd 0 gt { (.) cat /fr fi fm mod 12 string cvs def fd fr length sub { (0) cat } repeat fr cat } if } bind def
% temperature -> (0.8), (0.95), or (0) for greedy
/tfmt { dup 0 le { pop (0) } { dup dup 10 mul round 10 div sub abs 0.001 lt { 1 } { 2 } ifelse fmt } ifelse } bind def
/commas { 12 string cvs /cs exch def /cr () def /cn cs length def   % int -> "260,032"
  0 1 cn 1 sub { /ci exch def ci 0 gt cn ci sub 3 mod 0 eq and { /cr cr (,) cat def } if
    /cr cr cs ci 1 getinterval cat def } for cr } bind def
/tshow { exch 0 exch ashow } bind def                       % str tracking tshow
/tw { exch dup stringwidth pop exch length 3 -1 roll mul add } bind def   % str trk tw -> width
/rshow { dup stringwidth pop neg 0 rmoveto show } bind def
/F { findfont exch scalefont setfont } bind def             % size /Font F
/hline { /lw exch def /ly exch def lw setlinewidth 72 ly moveto 540 ly lineto stroke } bind def
% str x y width leading wrap -> y-of-last-line   (greedy word wrap in the current font)
/wrap { /wl exch def /wwid exch def /wy exch def /wx exch def /wsr exch def
  /wsp ( ) stringwidth pop def /wcx 0 def /wdone false def
  { wsr ( ) search { exch pop exch /wsr exch def } { /wdone true def } ifelse
    dup length 0 gt {
      dup stringwidth pop /wwd exch def
      wcx 0 gt { wcx wsp add wwd add wwid gt { /wy wy wl sub def /wcx 0 def } { /wcx wcx wsp add def } ifelse } if
      wx wcx add wy moveto show /wcx wcx wwd add def
    } { pop } ifelse
    wdone { exit } if
  } loop wy } bind def
% Times-Italic and Helvetica with a multiplication sign at \201 and a non-breaking space at \240
% (both slots are unused in StandardEncoding; wrap only breaks at byte 32)
/TVEnc StandardEncoding 256 array copy def TVEnc 129 /multiply put TVEnc 160 /space put   % \240 = non-breaking space
/refont { findfont dup length dict begin { 1 index /FID ne { def } { pop pop } ifelse } forall
  /Encoding TVEnc def currentdict end definefont pop } bind def
/TV-TI /Times-Italic refont /TV-H /Helvetica refont

/PRO NPARAMS 1000000 gt def
/MODELNAME where { pop } { /MODELNAME (stories260K printer-tuned) def } ifelse   % story weights: Karpathy's stories260K, printer fine-tune
/dot ( \264 ) def
/DISP DNAME (teddy-bear) eq { (teddy bear) } { DNAME } ifelse def
/ART DISP 0 get dup 97 eq 1 index 101 eq or 1 index 105 eq or 1 index 111 eq or exch 117 eq or { (an ) } { (a ) } ifelse def

% ---- smart quotes (typesetting only; the words are untouched) ----
/qopen false def
0 1 tlen 1 sub { /ci exch def
  TEXT ci get 34 eq {
    /pv ci 0 gt { TEXT ci 1 sub get } { 32 } ifelse def
    /nx ci tlen 1 sub lt { TEXT ci 1 add get } { 32 } ifelse def
    pv 32 eq pv 10 eq or pv 40 eq or { true } { nx 32 eq nx 10 eq or { false } { qopen not } ifelse } ifelse
    /qopen exch def TEXT ci qopen { 170 } { 186 } ifelse put
  } if
  TEXT ci get 10 eq { /qopen false def } if
} for

% ---- split into words; PARA marks the first word of each paragraph after the first ----
/MAXW 3000 def
/WORDS MAXW array def /PARA MAXW array def /WW MAXW array def /LS MAXW array def /LIND MAXW array def
/NW 0 def /wstart -1 def /pnew false def
0 1 tlen { /ci exch def
  /cb ci tlen lt { TEXT ci get } { 32 } ifelse def
  cb 32 eq cb 10 eq or {
    wstart 0 ge NW MAXW lt and {
      WORDS NW TEXT wstart ci wstart sub getinterval put PARA NW pnew put
      /NW NW 1 add def /pnew false def } if
    /wstart -1 def
    cb 10 eq NW 0 gt and { /pnew true def } if
  } { wstart 0 lt { /wstart ci def } if } ifelse
} for
/cutmid false def
eos not NW 0 gt and { WORDS NW 1 sub get dup length 1 sub get /lc exch def
  lc 46 ne lc 33 ne and lc 63 ne and lc 186 ne and { WORDS NW 1 sub 2 copy get (\274) cat put /cutmid true def } if } if

% ---- geometry: story column, then the doodle directly below it, then the run card ----
/SX 180 def /SW 360 def /STOP 652 def
/DS 172.8 def                 % 2.4 in: 16 doodle pixels of 10.8 pt (45 device pixels at 300 dpi, 90 at 600)
/BY 160 def /BH 58 def        % run card
/DGAP 30 def                  % story's last baseline -> top of the doodle
/SBOT BY BH add 16 add 12 add DS add DGAP add def   % lowest story baseline that still leaves room
/measure { 0 1 NW 1 sub { /wi exch def WW wi WORDS wi get stringwidth pop put } for
  /spw ( ) stringwidth pop def } bind def
/breaklines { /nlin 0 def /cx 0 def
  0 1 NW 1 sub { /wi exch def /w WW wi get def
    wi 0 eq { true } { PARA wi get } ifelse {
      LS nlin wi put LIND nlin wi 0 gt { IND } { 0 } ifelse put
      /cx LIND nlin get w add def /nlin nlin 1 add def
    } {
      cx spw add w add SW gt { LS nlin wi put LIND nlin 0 put /nlin nlin 1 add def /cx w def }
                              { /cx cx spw add w add def } ifelse
    } ifelse
  } for
  1 1 nlin 1 sub { /k exch def /ks LS k get def
    /ke k nlin 1 sub lt { LS k 1 add get } { NW } ifelse def
    /lastl ke NW ge { true } { PARA ke get } ifelse def
    lastl ke ks sub 1 eq and PARA ks get not and {
      ks LS k 1 sub get sub 3 ge { WW ks 1 sub get spw add WW ks get add SW le { LS k ks 1 sub put } if } if
    } if
  } for } bind def
/fitsize { /fit false def { /fs exch def /ld fs 1.42 mul def /IND fs 1.5 mul def
  fs /Times-Roman F measure breaklines
  nlin 1 sub ld mul STOP SBOT sub le { /fit true def exit } if } forall } bind def
[13 12.5 12 11.5 11 10.5 10 9.5 9 8.5 8] fitsize
/LASTY NW 0 gt { STOP nlin 1 sub ld mul sub } { STOP } ifelse def
/DT LASTY DGAP sub def        % doodle top, at least DGAP below the story
/DLO BY BH add 28 add def     % lowest doodle bottom, clear of the run card's labels
/DXTRA DT DS sub DLO sub def  % spare height when the story is short: split it above and below the doodle
DXTRA 0 gt { /DT DT DXTRA 2 div sub def } if
/DB DT DS sub def             % doodle bottom

0 setgray
% ---- masthead ----
30 /Helvetica-Bold F 72 714 moveto (TONER-1-V) show
11 /Helvetica F 72 693 moveto (State of the art among multimodal models that execute inside a print job.) show
8 /Helvetica-Bold F 540 731 moveto NPARAMS DOODLE /NPARAMS get add commas ( parameters) cat rshow
8 /Helvetica F 540 721 moveto NPARAMS commas ( story + ) cat DOODLE /NPARAMS get commas cat ( doodle, int8, one scale per row) cat rshow
540 711 moveto (Inference runs inside the PostScript interpreter) rshow
680 1.5 hline

% ---- left rail ----
7 /Helvetica-Bold F 72 STOP moveto (SAMPLE OUTPUT) 0.9 tshow
8 /Helvetica F (Unedited model output. No prompt: generation starts at the BOS token.)
  72 STOP 14 sub 88 10.5 wrap pop

% ---- story ----
fs /Times-Roman F
0 1 nlin 1 sub { /k exch def
  /ke k nlin 1 sub lt { LS k 1 add get } { NW } ifelse def
  /cx SX LIND k get add def /cy STOP k ld mul sub def
  LS k get 1 ke 1 sub { /wi exch def cx cy moveto WORDS wi get show /cx cx WW wi get add spw add def } for
} for
NW 0 eq { 10 /Helvetica F SX STOP moveto (The model emitted its end-of-story token immediately.) show } if

% ---- the doodle: 16 x 16 one-bit bitmap, imagemask, in the class color ----
0.5 setlinewidth 0.72 setgray SX 0.25 sub DB 0.25 sub DS 0.5 add DS 0.5 add rectstroke
SX DB DS DCLS TVcolor TVdraw
0 setgray

% left rail: what it is, and the 64 patch tokens as an 8 x 8 grid (hex patch values, "." = empty patch)
7 /Helvetica-Bold F 72 DT 7 sub moveto (ILLUSTRATION) 0.9 tshow
8 /Helvetica F (Drawn after the story by TONER-1-V, in the same print job, from 64 patch tokens.)
  72 DT 21 sub 88 10.5 wrap /RAILY2 exch def
7 /Helvetica-Bold F 72 RAILY2 22 sub moveto (PATCH TOKENS) 0.9 tshow
7.5 /Courier F
/HEXD (0123456789abcdef) def
0 1 7 { /gr exch def /hrow 15 string def
  0 1 7 { /gc exch def /hv DENG /PV get gr 8 mul gc add get def
    hrow gc 2 mul hv 0 eq { 46 } { HEXD hv get } ifelse put gc 7 lt { hrow gc 2 mul 1 add 32 put } if } for
  72 RAILY2 36 sub gr 8.6 mul sub moveto hrow show } for

% caption, to the right of the doodle
/CX SX DS add 18 add def /CW 540 CX sub def
10.5 /TV-TI F
ROUTED { (TONER-1-V's drawing of ) ART cat DISP cat (: 16\240\201\24016 pixels, generated inside this print job, upscaled by proprietary toner super-resolution.) cat }
       { (The story names nothing TONER-1-V knows how to draw, so TONER-1-V drew ) ART cat DISP cat
         ( anyway: 16\240\201\24016 pixels, generated inside this print job, upscaled by proprietary toner super-resolution.) cat } ifelse
  CX DT 9 sub CW 13.5 wrap /CAPY exch def
7 /Helvetica-Bold F CX CAPY 22 sub moveto (CLASS ROUTER) 0.9 tshow
8 /Helvetica F
ROUTED { (First drawable noun in the story: \252) rtword cat (\272, word ) cat rtwn 10 string cvs cat ( of ) cat NWORDS 10 string cvs cat
         (. Class token ) cat DOODLE /CLASS0 get DCLS add 10 string cvs cat ( \() cat DNAME cat (\).) cat }
       { (No keyword matched in ) NWORDS 10 string cvs cat ( words. Class from the seed: ) cat DSEED 12 string cvs cat ( mod 18 = ) cat
         DCLS 10 string cvs cat ( \() cat DNAME cat (\).) cat } ifelse
  CX CAPY 34 sub CW 10 wrap /CAPY exch def
7 /Helvetica-Bold F CX CAPY 20 sub moveto (SAMPLING) 0.9 tshow
8 /TV-H F (BOS, the class token, then 64 patch tokens at temperature ) DTEMP tfmt cat
  (, each drawn from the 16 patch values only. 65 forward passes.) cat
  CX CAPY 32 sub CW 10 wrap pop

% ---- run card: story on the left, doodle on the right ----
/CW 58.5 def
0.75 setlinewidth 72 BY 468 BH rectstroke
0.5 setlinewidth 1 1 7 { /ci exch def ci 4 ne { ci CW mul 72 add dup BY moveto BY BH add lineto stroke } if } for
1.5 setlinewidth 4 CW mul 72 add dup BY moveto BY BH add lineto stroke
7 /Helvetica-Bold F 72 BY BH add 7 add moveto (STORY  \264  ) MODELNAME cat 0.9 tshow
4 CW mul 72 add BY BH add 7 add moveto (DOODLE  \264  TONER-1-V) 0.9 tshow
/cell { /cv exch def /cl exch def /cn exch def /cxx cn CW mul 72 add 9 add def
  6.5 /Helvetica-Bold F cxx BY BH add 14 sub moveto cl 0.7 tshow
  20 /Helvetica-Bold F cxx BY 15 add moveto cv show } bind def
0 (TOKENS) ntok 10 string cvs cell
1 (TOK / SEC) tps dup 10 lt { 2 } { 1 } ifelse fmt cell
2 (SEED) SEED 12 string cvs cell
3 (TEMP) TEMP tfmt cell
4 (TOKENS) (64) cell
5 (TOK / SEC) dtps dup 100 lt { 1 } { 0 } ifelse fmt cell
6 (SEED) DSEED 12 string cvs cell
7 (TEMP) DTEMP tfmt cell

% ---- footer ----
/flab { 6.5 /Helvetica-Bold F 72 exch moveto 0.7 tshow } bind def
/fval { 8 /Helvetica F 152 exch moveto show } bind def
/IDENT /product where { pop product } { (unknown interpreter) } ifelse def
/revision where { pop /IDENT IDENT dot cat (revision ) cat revision 12 string cvs cat def } if
/version where { pop /IDENT IDENT dot cat (PostScript version ) cat version cat def } if
(INTERPRETER) 136 flab IDENT 136 fval
(STORY MODEL) 124 flab
MODELNAME ( \(Llama-2 architecture\)) cat dot cat (dim ) cat D 6 string cvs cat dot cat
  NL 4 string cvs cat ( layers) cat dot cat NH 4 string cvs cat ( query / ) cat NKV 4 string cvs cat
  ( KV heads) cat dot cat V commas cat (-token vocab) cat 124 fval
(DOODLE MODEL) 112 flab
DOODLE begin
(TONER-1-V \(Llama-2 architecture\)) dot cat (dim ) cat D 6 string cvs cat dot cat
  NL 4 string cvs cat ( layers) cat dot cat NH 4 string cvs cat ( query / ) cat NKV 4 string cvs cat
  ( KV heads) cat dot cat V commas cat (-token vocab) cat
end 112 fval
(STOPPED BY) 100 flab
eos { (End-of-story token, after ) ntok 10 string cvs cat ( tokens) cat }
    { (Token budget: STEPS = ) STEPS 10 string cvs cat
      cutmid { (. The story was cut off mid-thought.) } { (, reached before the end-of-story token.) } ifelse cat } ifelse
ndrop 0 gt { dot cat ndrop 10 string cvs cat ( non-Latin characters not typeset) cat } if
  dot cat (doodle: 64 patch tokens, fixed length) cat 100 fval
0.5 setlinewidth 72 90 moveto 540 90 lineto stroke
9 /Helvetica-Bold F 72 76 moveto (Host compute: 0 FLOPs. Inference cost includes toner, now in color.) show
6.5 /Helvetica F
(Every word and every pixel above was generated on-device, one token at a time, by the interpreter named in this footer; )
  (the host computer only sent bytes. Seconds are interpreter usertime spent generating. rand is implementation-defined, ) cat
  (so the same seeds on another interpreter tell a different story and draw a different picture. ) cat
  (Drawings learned from the Quick, Draw! dataset \(Google, CC BY 4.0\).) cat
  72 65 468 8 wrap pop
showpage
vmstatus /vmmax exch def /vmused exch def /vmlev exch def
(VM: ) print vmused =only ( bytes used of ) print vmmax =only ( allocated \(save level ) print vmlev =only (\)\n) print flush
%%EOF
