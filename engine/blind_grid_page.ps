% ---------------- TONER-1-V blind grid: 36 unlabeled doodles, all generated by this job ----------------
% Needs DOODLE, the doodle engine (TVgen TVdraw TVms), TVH (house.ps) and /BORDER (eval_key/blind_order.ps:
% class index and seed for cells 1..36). Every doodle is drawn in black, with no class anywhere on the page.
TVH begin
/setpagedevice where { pop mark { 1 dict dup /PageSize [612 792] put setpagedevice } stopped cleartomark } if
/NCELL BORDER length 2 idiv def
/CLN DOODLE /CLASSES get def

% ---- 6 x 6 grid of 68 pt doodles, numbered row by row ----
/S 68 def /PX 86.4 def /PY 84 def /GT0 610 def
/cellxy { % k (0-based) -> x y   (lower-left corner of the doodle)
  /ck exch def 54 ck 6 mod PX mul add PX S sub 2 div add  GT0 ck 6 idiv PY mul sub 11 sub S sub } bind def

(TONER-1-V blind grid | ) print NCELL =only ( doodles | T ) print DTEMP =only (\n) print flush
/totms 0 def
0 1 NCELL 1 sub { /k exch def
  k cellxy /cy exch def /cx exch def
  cx 0.2 sub cy 0.2 sub S 0.4 add S 0.4 add 0.4 0.78 rs
  0 setgray 7 fHB cx cy S add 3.5 add moveto k 1 add 4 string cvs show
  save
    BORDER k 2 mul get BORDER k 2 mul 1 add get TVgen
    cx cy S 0 0 0 TVdraw
    (D ) print k 1 add =only ( ) print BORDER k 2 mul get =only ( ) print BORDER k 2 mul 1 add get =only ( ) print TVtokprint (\n) print flush
    TVms
  exch restore
  /totms exch totms add def
} for
/tsec totms 1000 div def
/tps tsec 0 gt { NCELL 64 mul tsec div } { 0 } ifelse def
(---\n) print NCELL =only ( doodles, ) print NCELL 64 mul =only ( patch tokens in ) print tsec =only ( s = ) print
  tps =only ( tok/s, ) print tsec NCELL div =only ( s per doodle\n) print flush

% ---- page furniture ----
(TONER-1-V BLIND GRID) header
0 setgray 26 fHB 54 688 moveto (TONER-1-V blind grid) show
12.5 fTI 0.15 setgray 54 668 moveto (Thirty-six doodles, two of each class, shuffled. Which is which?) show
54 558 652 10 fl-begin 0.25 setgray 7.8 fH
(Every doodle was generated inside this print job at temperature ) DTEMP 1 fmt cat
  (, each from its own seed, and drawn in the same black so color gives nothing away. The classes, two doodles each: ) cat fseg
0 1 CLN length 1 sub { /ci exch def CLN ci get ci CLN length 1 sub lt { (,) cat } { (.) cat } ifelse fseg } for
( The answer key is kept separately.) fseg

% ---- timings, one line ----
0.3 setgray 6.2 fHB 54 84 moveto (RUN) 0.7 tsh
6.6 fH 0 setgray 80 84 moveto
NCELL 10 string cvs ( doodles \264 ) cat NCELL 64 mul commas cat ( patch tokens \264 ) cat tsec 1 fmt cat ( s \264 ) cat
  tsec NCELL div 2 fmt cat ( s per doodle \264 ) cat tps 0 fmt cat ( tok/s \264 ) cat IDENT cat show
(Generated inside this print job. Drawings learned from the Quick, Draw! dataset \(Google, CC BY 4.0\).) (Page 1 of 1) footer
end
showpage
vmstatus /vmmax exch def /vmused exch def /vmlev exch def
(VM: ) print vmused =only ( bytes used of ) print vmmax =only ( allocated \(save level ) print vmlev =only (\)\n) print flush
