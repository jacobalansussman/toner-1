% ---------------- TONER-1-V sample sheet: 18 classes x 4 doodles, all generated by this job ----------------
% Needs DOODLE, the doodle engine (TVgen TVdraw TVcolor TVms) and TVH (house.ps).
TVH begin
/setpagedevice where { pop mark { 1 dict dup /PageSize [612 792] put setpagedevice } stopped cleartomark } if
/SHEETSEED where { pop } { /SHEETSEED 1 def } ifelse   % gs -dSHEETSEED=... ; doodle k (class-major) uses SHEETSEED + k
/NPER 4 def
/NCL DOODLE /NCLASS get def
/CLN DOODLE /CLASSES get def

% ---- grid geometry: 9 class columns x 2 bands; each column is a label over 4 stacked doodles ----
/S 50 def /PITCH 56 def /VG 5 def
/GT0 606 def /BANDH 8 S NPER mul add VG NPER 1 sub mul add def /BANDGAP 20 def
/cellxy { % cls i -> x y   (lower-left corner of the doodle)
  /ci2 exch def /cc2 exch def
  54 cc2 9 mod PITCH mul add PITCH S sub 2 div add
  GT0 cc2 9 idiv BANDH BANDGAP add mul sub 8 sub S sub ci2 S VG add mul sub } bind def

% ---- generate and draw: each doodle inside save/restore, only its usertime survives (an integer) ----
(TONER-1-V sample sheet | ) print NCL NPER mul =only ( doodles | T ) print DTEMP =only ( | first seed ) print SHEETSEED =only (\n) print flush
/totms 0 def /ndood 0 def
0 1 NCL 1 sub { /cls exch def
  0 1 NPER 1 sub { /ii exch def
    /sd SHEETSEED cls NPER mul add ii add def
    cls ii cellxy /cy exch def /cx exch def
    cx 0.2 sub cy 0.2 sub S 0.4 add S 0.4 add 0.4 0.78 rs
    save
      cls sd TVgen
      cx cy S cls TVcolor TVdraw
      (D ) print cls =only ( ) print sd =only ( ) print TVtokprint (\n) print flush
      TVms
    exch restore
    /totms exch totms add def /ndood ndood 1 add def
  } for
} for
/tsec totms 1000 div def
/tps tsec 0 gt { ndood 64 mul tsec div } { 0 } ifelse def
(---\n) print ndood =only ( doodles, ) print ndood 64 mul =only ( patch tokens in ) print tsec =only ( s = ) print
  tps =only ( tok/s, ) print tsec ndood div =only ( s per doodle\n) print flush

% ---- class labels ----
0 1 NCL 1 sub { /cls exch def
  0 setgray 6.4 fHB
  cls 0 cellxy pop S 2 div add  cls 0 cellxy exch pop S add 4.5 add moveto
  CLN cls get upper 0.5 tcsh } for

% ---- page furniture ----
(TONER-1-V SAMPLE SHEET) header
0 setgray 26 fHB 54 688 moveto (TONER-1-V sample sheet) show
12.5 fTI 0.15 setgray 54 668 moveto (Eighteen classes, four doodles each, every pixel drawn inside this one print job.) show
54 558 652 10 fl-begin 0.25 setgray 7.8 fH
(16\240\201\24016 one-bit pixels each: after BOS and a class token, TONER-1-V samples 64 patch tokens \(2\240\201\2402 pixels, 16 possible values\) at temperature )
  DTEMP 1 fmt cat (, one forward pass per token, with a ) cat DOODLE /NPARAMS get commas cat (-parameter int8 transformer. Seeds ) cat
  SHEETSEED 12 string cvs cat (\261) cat SHEETSEED ndood add 1 sub 12 string cvs cat (, top to bottom within each class; unedited, nothing cherry-picked.) cat fseg

% ---- timings ----
54 94 504 34 [
  [(DOODLES) ndood 10 string cvs]
  [(PATCH TOKENS) ndood 64 mul commas]
  [(SECONDS) tsec 1 fmt]
  [(SEC / DOODLE) tsec ndood div 2 fmt]
  [(TOKENS / SEC) tps 0 fmt]
  [(TEMPERATURE) DTEMP 1 fmt]
] statcard
0.3 setgray 6.2 fHB 54 84 moveto (INTERPRETER) 0.7 tsh 6.6 fH 0 setgray 112 84 moveto IDENT show
0.3 setgray 6.6 fH 558 84 moveto (Seconds are interpreter usertime spent generating.) rsh
(Generated inside this print job. Drawings learned from the Quick, Draw! dataset \(Google, CC BY 4.0\).) (Page 1 of 1) footer
end
showpage
vmstatus /vmmax exch def /vmused exch def /vmlev exch def
(VM: ) print vmused =only ( bytes used of ) print vmmax =only ( allocated \(save level ) print vmlev =only (\)\n) print flush
